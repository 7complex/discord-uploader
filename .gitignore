# Logs
*.log

# macOS
.DS_Store

# Configurações de editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Go
/vendor/
*.exe
/test-results/

# Fyne / AppImage builds
squashfs-root/
AppDir/
*.tar.xz

# Cópia do CLI gerada no build da GUI (derivada de ../discord-uploader.sh)
gui/discord-uploader.sh

# Variáveis de ambiente locais
.env
.env.local
